# GatherRadar Telegram bot — example only. Never commit real values.
# GatherRadar reads these from the process environment; it does not load .env files.
# Set them as Windows user environment variables (see docs/TELEGRAM_BOT_SETUP.md).
GATHERRADAR_TELEGRAM_BOT_TOKEN=123456789:replace-with-the-token-from-BotFather
# Numeric Telegram user ID of the owner; leave empty until /whoami has shown it.
GATHERRADAR_TELEGRAM_OWNER_ID=
